generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerType {
  UNKNOWN
  PROFESSIONAL
  PRIVATE
}

enum SellerVatStatus {
  UNKNOWN
  REGISTERED
  NOT_REGISTERED_OR_NOT_APPLICABLE
}

enum ProductReportReason {
  ILLEGAL
  UNSAFE
  COUNTERFEIT
  INTELLECTUAL_PROPERTY
  MISLEADING
  PROHIBITED
  OTHER
}

enum ProductReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  EXPIRED
}

enum StoreAccessSource {
  ADMIN_GRANTED
  ADMIN_EXEMPT
}

enum ProductDeactivationReason {
  NONE
  SELLER
  ADMIN
  SUBSCRIPTION_INACTIVE
}

enum SupplierProvider {
  CJ
}

enum SupplierOwnerType {
  PLATFORM
  SELLER
}

enum SupplierConnectionStatus {
  DISCONNECTED
  CONNECTED
  RECONNECT_REQUIRED
  REVOKED
}

enum SupplierSyncStatus {
  HEALTHY
  PRICE_CHANGED
  UNAVAILABLE
  ERROR
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum ProductMediaProvider {
  CLOUDINARY
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  REJECTED
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                       String   @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String   @unique
  passwordHash             String
  role                     UserRole @default(CUSTOMER)
  storeName                String?
  emailVerified            Boolean  @default(false)
  emailVerifiedAt          DateTime?
  stripeAccountId          String?  @unique
  stripeOnboardingComplete Boolean  @default(false)
  stripeChargesEnabled     Boolean  @default(false)
  stripePayoutsEnabled     Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  store               Store?
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  sentMessages        Message[]
  notifications       Notification[]
  orders              Order[]
  reviews             Review[]
  reviewReports       ReviewReport[]
  refundRequests      RefundRequest[] @relation("RefundRequestBuyer")
  reviewedRefundRequests RefundRequest[] @relation("RefundRequestReviewer")
  uploadedRefundEvidence RefundEvidence[] @relation("RefundEvidenceUploader")
  productReports      ProductReport[]
  productReportsReviewed ProductReport[] @relation("ProductReportReviewer")
  productModerationEvents ProductModerationEvent[] @relation("ProductModerationActor")
  accessGrantsCreated StoreAccessGrant[] @relation("AccessGrantAdmin")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Store {
  id               String       @id @default(cuid())
  name             String       @unique
  slug             String       @unique
  description      String?
  logo             String?      @map("logoUrl")
  banner           String?
  country          String
  city             String
  contactEmail     String
  phone            String?
  currency         String       @default("EUR")
  language         String       @default("fr")
  status           SellerStatus @default(PENDING)
  stripeCustomerId String?      @unique
  sellerType       SellerType   @default(UNKNOWN)
  legalBusinessName String?
  businessRegistrationId String?
  businessAddress  String?
  businessPostalCode String?
  vatNumber        String?
  vatStatus        SellerVatStatus @default(UNKNOWN)
  shippingEnabled  Boolean      @default(false)
  shippingMethodName String?
  shippingPrice    Decimal?     @db.Decimal(12, 2)
  shippingFree     Boolean      @default(false)
  shippingMinDays  Int?
  shippingMaxDays  Int?
  shippingCountries String[]    @default([])
  shippingWorldwide Boolean     @default(false)
  shippingPostalCodes String[]  @default([])
  shippingFreeThreshold Decimal? @db.Decimal(12, 2)
  shippingCarrier String?
  shippingProvider String       @default("MANUAL")
  shippingExternalServiceId String?
  dropshippingEnabled Boolean @default(false)

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products      Product[]
  conversations Conversation[]
  subscription  SellerSubscription?
  accessGrants  StoreAccessGrant[]
  supplierConnections SupplierConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderSnapshotSource {
  CHECKOUT_CAPTURED
  LEGACY_RECONSTRUCTED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
}

enum FulfillmentEventSource {
  SYSTEM
  SELLER
  ADMIN
}

enum RefundRequestStatus {
  PENDING
  SELLER_APPROVED
  SELLER_REJECTED
  ADMIN_APPROVED
  ADMIN_REJECTED
}

enum RefundEvidenceUploaderRole {
  BUYER
}

enum OrderIssueType {
  CANCELLATION
  RETURN
  DISPUTE
}

enum OrderIssueStatus {
  PENDING
  SELLER_APPROVED
  SELLER_REJECTED
  ESCALATED
  RESOLVED
}

model StoreAccessGrant {
  id          String            @id @default(cuid())
  storeId     String
  grantedById String
  source      StoreAccessSource
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime          @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("AccessGrantAdmin", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([storeId, source, endsAt])
  @@index([grantedById, createdAt])
}

model Product {
  id                 String                    @id @default(cuid())
  name               String
  slug               String
  description        String
  price              Decimal                   @db.Decimal(12, 2)
  compareAtPrice     Decimal?                  @db.Decimal(12, 2)
  colors             String[]                  @default([])
  sizes              String[]                  @default([])
  currency           String                    @default("EUR")
  category           String
  stock              Int                       @default(1)
  condition          String
  images             String[]
  status             ProductStatus             @default(PUBLISHED)
  deactivationReason ProductDeactivationReason @default(NONE)
  allowPrepurchaseQuestions Boolean               @default(true)
  productIdentifier String?
  manufacturerName String?
  manufacturerContact String?
  responsiblePerson String?
  safetyInformation String? @db.Text
  complianceInformation String? @db.Text
  complianceDeclaredAt DateTime?
  shippingOverrideEnabled Boolean @default(false)
  shippingEnabled Boolean?
  shippingMethodName String?
  shippingPrice Decimal? @db.Decimal(12, 2)
  shippingFree Boolean?
  shippingFreeThreshold Decimal? @db.Decimal(12, 2)
  shippingMinDays Int?
  shippingMaxDays Int?
  shippingCountries String[] @default([])
  shippingWorldwide Boolean?
  shippingPostalCodes String[] @default([])
  shippingCarrier String?
  shippingProvider String?
  shippingExternalServiceId String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  orderItems    OrderItem[]
  reviews       Review[]
  options       ProductOption[]
  variants      ProductVariant[]
  imageRecords  ProductImage[]
  reports       ProductReport[]
  supplierLink  SupplierProductLink?
  media         ProductMedia[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([category])
}

model SupplierProductLink {
  id                    String             @id @default(cuid())
  productId             String             @unique
  provider              SupplierProvider
  ownerType             SupplierOwnerType @default(PLATFORM)
  connectionId          String?
  supplierProductId     String
  supplierSku           String?
  sourceUrl             String?
  supplierCost          Decimal?           @db.Decimal(12, 2)
  previousSupplierCost  Decimal?           @db.Decimal(12, 2)
  supplierCurrency      String?            @db.VarChar(3)
  supplierStock         Int?
  supplierAvailable     Boolean            @default(true)
  syncStatus            SupplierSyncStatus @default(HEALTHY)
  lastSyncedAt          DateTime?
  lastSyncError         String?            @db.VarChar(500)
  sourceMetadata        Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  connection SupplierConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([provider, supplierProductId])
  @@index([provider, syncStatus, lastSyncedAt])
  @@index([connectionId, syncStatus, lastSyncedAt])
}

model SupplierConnection {
  id                String                   @id @default(cuid())
  provider          SupplierProvider
  ownerType         SupplierOwnerType
  storeId           String?
  status            SupplierConnectionStatus @default(DISCONNECTED)
  externalAccountId String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  lastCheckedAt     DateTime?
  lastErrorCategory String?                  @db.VarChar(80)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productLinks SupplierProductLink[]

  @@index([ownerType, storeId, provider, status])
  @@index([provider, status])
}

model ProductMedia {
  id          String               @id @default(cuid())
  productId   String
  type        ProductMediaType
  provider    ProductMediaProvider
  publicId    String
  url         String
  posterUrl   String?
  position    Int
  width       Int?
  height      Int?
  durationMs  Int?
  sourceUrl   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@unique([provider, publicId])
  @@index([productId, type, position])
}

model SellerSubscription {
  id                   String             @id @default(cuid())
  storeId              String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String
  plan                 String
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Conversation {
  id            String   @id @default(cuid())
  buyerId       String
  sellerId      String
  storeId       String
  productId     String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, productId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(2000)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Order {
  id                       String      @id @default(cuid())
  buyerId                  String
  status                   OrderStatus @default(PENDING)
  currency                 String      @default("EUR")
  total                    Decimal     @db.Decimal(12, 2)
  paidAt                   DateTime?
  checkoutRequestId        String
  stripeCheckoutSessionId  String?     @unique
  stripeCheckoutUrl        String?
  stripePaymentIntentId    String?     @unique
  stripeConnectedAccountId String?
  platformFeeAmount        Int?
  sellerAmount             Int?
  deliveredAt              DateTime?
  snapshotSource           OrderSnapshotSource?
  snapshotCapturedAt       DateTime?
  storeIdSnapshot          String?
  storeNameSnapshot        String?
  sellerTypeSnapshot       SellerType?
  sellerVatStatusSnapshot  SellerVatStatus?
  storeSnapshot            Json?
  sellerInvoiceReference   String?
  sellerInvoiceUrl         String?
  sellerInvoiceIssuedAt    DateTime?
  buyerNameSnapshot        String?
  buyerEmailSnapshot       String?
  buyerPhoneSnapshot       String?
  recipientName            String?
  recipientEmail           String?
  recipientPhone           String?
  shippingAddressLine1     String?
  shippingAddressLine2     String?
  shippingCity             String?
  shippingPostalCode       String?
  shippingState            String?
  shippingCountry          String?
  shippingMethod           String?
  shippingCost             Decimal? @db.Decimal(12, 2)
  shippingCurrency         String?  @db.VarChar(3)
  shippingEstimatedMinDays Int?
  shippingEstimatedMaxDays Int?
  shippingCarrier          String?
  shippingProvider         String?
  shippingExternalServiceId String?
  shippingPolicySnapshot    Json?
  subtotal                 Decimal? @db.Decimal(12, 2)
  taxTotal                 Decimal? @db.Decimal(12, 2)
  fulfillmentStatus        FulfillmentStatus?
  processingAt             DateTime?
  packedAt                 DateTime?
  shippedAt                DateTime?
  trackingCarrier          String?
  trackingNumber           String?
  trackingUrl              String?
  shippingCapturedAt       DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  buyer User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  fulfillmentEvents OrderFulfillmentEvent[]
  refundRequest      RefundRequest?
  issues             OrderIssue[]
  lifecycleEvents    OrderLifecycleEvent[]

  @@unique([buyerId, checkoutRequestId])
  @@index([buyerId, status, createdAt])
  @@index([storeIdSnapshot])
  @@index([fulfillmentStatus])
}

model ProductReport {
  id          String              @id @default(cuid())
  productId   String
  reporterId  String
  reason      ProductReportReason
  details     String              @db.VarChar(1500)
  status      ProductReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt DateTime?
  resolutionNote String? @db.VarChar(1000)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProductReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events ProductModerationEvent[]

  @@unique([productId, reporterId])
  @@index([status, createdAt])
  @@index([reviewedById, reviewedAt])
}

model ProductModerationEvent {
  id         String              @id @default(cuid())
  reportId   String
  actorId    String
  fromStatus ProductReportStatus
  toStatus   ProductReportStatus
  action     String              @db.VarChar(50)
  note       String?             @db.VarChar(1000)
  createdAt  DateTime            @default(now())

  report ProductReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User          @relation("ProductModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  lineKey                    String?
  productNameSnapshot        String?
  productDescriptionSnapshot String? @db.Text
  productImageUrlSnapshot    String?
  productSkuSnapshot         String?
  currency                   String? @db.VarChar(3)
  lineTotal                  Decimal? @db.Decimal(12, 2)
  selectedSize               String?
  selectedColor              String?
  selectedOptions            Json?
  variantId                  String?
  variantTitleSnapshot       String?
  variantSkuSnapshot         String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review  Review?

  @@unique([orderId, lineKey])
  @@index([productId])
  @@index([variantId])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(80)
  position  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId, position])
}

model ProductOptionValue {
  id        String   @id @default(cuid())
  optionId  String
  value     String   @db.VarChar(100)
  position  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option        ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantValue[]
  imageAssignments ProductOptionValueImage[]

  @@unique([optionId, value])
  @@unique([optionId, position])
  @@index([optionId, position])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  position  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValueImages ProductOptionValueImage[]

  @@unique([productId, position])
  @@index([productId, position])
  @@index([productId, url])
}

model ProductOptionValueImage {
  optionValueId String
  imageId       String
  position      Int
  isPrimary     Boolean @default(false)

  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  image       ProductImage       @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([optionValueId, imageId])
  @@unique([optionValueId, position])
  @@index([imageId])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  combinationKey  String   @db.VarChar(500)
  sku             String?  @unique @db.VarChar(120)
  barcode         String?  @db.VarChar(120)
  priceOverride   Decimal? @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  stock           Int      @default(0)
  active          Boolean  @default(true)
  supplierProvider  SupplierProvider?
  supplierVariantId String? @db.VarChar(200)
  supplierSku       String? @db.VarChar(200)
  supplierCost      Decimal? @db.Decimal(12, 2)
  supplierStock     Int?
  supplierAvailable Boolean?
  supplierLastSyncedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductVariantValue[]
  orderItems OrderItem[]

  @@unique([productId, combinationKey])
  @@unique([supplierProvider, supplierVariantId])
  @@index([productId, active])
}

model ProductVariantValue {
  variantId     String
  optionValueId String

  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model RefundRequest {
  id             String              @id @default(cuid())
  orderId        String
  buyerId        String
  reason         String              @db.VarChar(1000)
  status         RefundRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  decisionNote   String?             @db.VarChar(1000)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer      User  @relation("RefundRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RefundRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence   RefundEvidence[]

  @@unique([orderId])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model RefundEvidence {
  id               String                     @id @default(cuid())
  refundRequestId  String
  uploadedByUserId String
  uploaderRole     RefundEvidenceUploaderRole
  storageKey       String
  contentHash      String                     @db.Char(64)
  originalFilename String                     @db.VarChar(255)
  mimeType         String                     @db.VarChar(32)
  sizeBytes        Int
  createdAt        DateTime                   @default(now())

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("RefundEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([refundRequestId, storageKey])
  @@unique([refundRequestId, contentHash])
  @@index([refundRequestId, createdAt])
  @@index([uploadedByUserId, createdAt])
}

model OrderFulfillmentEvent {
  id         String                 @id @default(cuid())
  orderId    String
  status     FulfillmentStatus
  source     FulfillmentEventSource
  actorId    String?
  occurredAt DateTime               @default(now())
  metadata   Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

model OrderIssue {
  id          String           @id @default(cuid())
  orderId     String
  buyerId     String
  type        OrderIssueType
  status      OrderIssueStatus @default(PENDING)
  reason      String           @db.VarChar(120)
  description String           @db.VarChar(1000)
  reviewedById String?
  reviewedAt  DateTime?
  decisionNote String?         @db.VarChar(1000)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model OrderLifecycleEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String   @db.VarChar(80)
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  authorId    String
  orderItemId String       @unique
  rating      Int
  title       String?      @db.VarChar(120)
  body        String       @db.VarChar(2000)
  status      ReviewStatus @default(PUBLISHED)
  sellerReply String?      @db.VarChar(1500)
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  reports   ReviewReport[]

  @@unique([authorId, productId])
  @@index([productId, status, createdAt])
}

model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String
  reporterId String
  reason     String             @db.VarChar(500)
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
}
